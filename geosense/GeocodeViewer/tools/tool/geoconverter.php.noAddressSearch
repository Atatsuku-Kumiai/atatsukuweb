		locapo = locapo.replace( /[ 　\t]/, "" );
		var format = /([A-Z]+[0-9]\.){3}[A-Z]+[0-9]/;
		if ( locapo.length < 7  || ! locapo.match(format) ){
			alert("ロカポの形式に合致しているか確認して下さい。");
			retrun;
		}
	}

	var latlon =  LocaPoint2LatLon( locapo );

