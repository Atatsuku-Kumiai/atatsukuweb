function dispLocapoPosition( locapo )
{
	if ( gDatum == TOKYO ){
		alert("ロカポは日本測地系では表示できません。");
		return;
		//latlon = geoDatumTokyo2World( 1, latlon.lat, latlon.lon, 0 );
	}

	if ( ! locapo ){
